<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Insait_Notes_Android.Models"
             x:Class="Insait_Notes_Android.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource InsaitPeach}">

    <Grid RowDefinitions="48,40,*,24">

        <!-- ===== Title bar ===== -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource InsaitDark}"
              ColumnDefinitions="Auto,*,Auto"
              Padding="12,0">

            <HorizontalStackLayout Grid.Column="0"
                                   Spacing="10"
                                   VerticalOptions="Center">
                <Image Source="insait_icon.png"
                       HeightRequest="26"
                       WidthRequest="26"
                       VerticalOptions="Center" />
                <Label Text="Insait Notes"
                       TextColor="White"
                       FontSize="15"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="16"
                                   VerticalOptions="Center">
                <Image Source="insait_tabs.png"
                       HeightRequest="26"
                       WidthRequest="26"
                       VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabsCenterTapped" />
                    </Image.GestureRecognizers>
                </Image>
                <Border Background="{StaticResource InsaitOrangeBrush}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,4"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLangTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LangLabel"
                           Text="EN"
                           TextColor="{StaticResource InsaitDark}"
                           FontAttributes="Bold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </Border>
                <Image Source="insait_info.png"
                       HeightRequest="22"
                       WidthRequest="22"
                       VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInfoTapped" />
                    </Image.GestureRecognizers>
                </Image>
                <Image Source="insait_license.png"
                       HeightRequest="22"
                       WidthRequest="22"
                       VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLicenseTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </HorizontalStackLayout>
        </Grid>

        <!-- ===== Note title ===== -->
        <Grid Grid.Row="1"
              BackgroundColor="White"
              HeightRequest="40"
              Padding="14,0">
            <Label x:Name="NoteTitleLabel"
                   VerticalOptions="Center"
                   FontSize="14"
                   TextColor="#222222"
                   LineBreakMode="TailTruncation" />
            <BoxView HeightRequest="1"
                     Color="{StaticResource InsaitPeachBorder}"
                     VerticalOptions="End" />
        </Grid>

        <!-- ===== Editor ===== -->
        <Grid Grid.Row="2"
              BackgroundColor="{StaticResource InsaitPeach}"
              Padding="12">
            <Border Background="{StaticResource InsaitEditorBrush}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 3">
                <Editor x:Name="NoteEditor"
                        Margin="8,4"
                        BackgroundColor="Transparent"
                        TextColor="#222222"
                        FontSize="14"
                        AutoSize="Disabled"
                        TextChanged="OnEditorTextChanged">
                    <Editor.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditorTapped" />
                    </Editor.GestureRecognizers>
                </Editor>
            </Border>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Grid Grid.Row="3" BackgroundColor="{StaticResource InsaitDark}">
            <Label x:Name="StatusLabel"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="11"
                   TextColor="{StaticResource InsaitStatusText}" />
        </Grid>

        <!-- ===== About overlay ===== -->
        <Grid x:Name="AboutOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              IsVisible="False"
              BackgroundColor="#99000000">
            <Border Background="White"
                    WidthRequest="320"
                    Stroke="#d9d2ec"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Grid RowDefinitions="44,*">
                    <Grid Grid.Row="0"
                          BackgroundColor="{StaticResource InsaitDark}"
                          ColumnDefinitions="Auto,*,Auto"
                          Padding="12,0">
                        <Image Grid.Column="0"
                               Source="insait_icon.png"
                               HeightRequest="22"
                               WidthRequest="22"
                               VerticalOptions="Center" />
                        <Label x:Name="AboutTitleLabel"
                               Grid.Column="1"
                               Margin="10,0"
                               TextColor="White"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Image Grid.Column="2"
                               Source="insait_close.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseAbout" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <VerticalStackLayout Grid.Row="1"
                                         Padding="24"
                                         Spacing="8">
                        <Image Source="insait_icon.png"
                               HeightRequest="56"
                               WidthRequest="56"
                               HorizontalOptions="Start" />
                        <Label x:Name="AboutHeadingLabel"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource InsaitDark}" />
                        <Label x:Name="AboutDevLabel"
                               FontSize="13"
                               TextColor="#333333" />
                        <Label x:Name="AboutDateLabel"
                               FontSize="13"
                               TextColor="#333333" />
                        <Label x:Name="AboutLangLabel"
                               FontSize="13"
                               TextColor="#333333" />
                        <Label x:Name="AboutVersionLabel"
                               FontSize="13"
                               TextColor="#333333" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== License overlay ===== -->
        <Grid x:Name="LicenseOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              IsVisible="False"
              BackgroundColor="#99000000">
            <Border Background="White"
                    WidthRequest="340"
                    MaximumHeightRequest="560"
                    Stroke="#d9d2ec"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Grid RowDefinitions="44,*">
                    <Grid Grid.Row="0"
                          BackgroundColor="{StaticResource InsaitDark}"
                          ColumnDefinitions="Auto,*,Auto"
                          Padding="12,0">
                        <Image Grid.Column="0"
                               Source="insait_license.png"
                               HeightRequest="22"
                               WidthRequest="22"
                               VerticalOptions="Center" />
                        <Label x:Name="LicenseTitleLabel"
                               Grid.Column="1"
                               Margin="10,0"
                               TextColor="White"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Image Grid.Column="2"
                               Source="insait_close.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseLicense" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <ScrollView Grid.Row="1" Padding="20">
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="LicHeadingLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource InsaitDark}" />
                            <Label x:Name="LicSubtitleLabel"
                                   FontSize="12"
                                   TextColor="#555555" />
                            <Label x:Name="LicP1Label"
                                   FontSize="14"
                                   TextColor="#333333" />
                            <Label x:Name="LicP2Label"
                                   FontSize="14"
                                   TextColor="#333333" />
                            <Label x:Name="LicP3Label"
                                   FontSize="14"
                                   TextColor="#333333" />
                            <Label x:Name="LicP5Label"
                                   FontSize="14"
                                   TextColor="#333333" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
